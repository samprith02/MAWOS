__pycache__/
*.pyc
.pytest_cache/
mawos.db
ml/models/*.joblib
ml/data/*.csv
evaluation/results/*
# Two directories are tracked deliberately, and must never be conflated:
#   v2_historical/ - what v2 originally reported, preserved unmodified
#   v2_frozen/     - the same system re-measured under PROTOCOL.md
# A comparator that is not version-controlled is not frozen, and a
# regenerated result that overwrites a historical one destroys the ability
# to say which instrument produced which number.
!evaluation/results/v2_historical/
!evaluation/results/v2_frozen/
evaluation/results/v2_frozen/_scratch.db
fl/results/
.venv/
venv/
