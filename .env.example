# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# The provider probe reads credentials from the process environment first and
# falls back to this file, so nothing has to be typed into a shell.

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- v5 hosted provider candidates (R0.5 re-run, D1) ---
# Groq: free tier, 14,400 req/day, no card. https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: 50 req/day free. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# GitHub Models: 50 req/day high-tier. A fine-grained PAT with models:read.
GITHUB_MODELS_TOKEN=
