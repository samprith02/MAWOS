# Explicit application mode: development, test, or production.
MAWOS_ENV=development

# Generate a long random value for every environment. The development fallback
# is intentionally insecure and must never be used in production.
MAWOS_JWT_SECRET=replace-with-a-long-random-secret

# Demo accounts are never created unless this is explicitly enabled outside
# production. Keep false for normal development and all production deployments.
MAWOS_SEED_DEMO_DATA=false
