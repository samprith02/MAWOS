# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# The provider probe reads credentials from the process environment first and
# falls back to this file, so nothing has to be typed into a shell.

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional, for the free-tier hosted class of the R0.5 shortlist
GROQ_API_KEY=
